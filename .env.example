# ====================================================================
# DISCORD BOT & API CONFIGURATION
# ====================================================================

# Token secreto do bot gerado em https://discord.com/developers/applications
DISCORD_BOT_TOKEN="SEU_DISCORD_BOT_TOKEN_AQUI"

# Application ID / Client ID do bot no Discord Developer Portal
DISCORD_CLIENT_ID="SEU_DISCORD_CLIENT_ID_AQUI"
NEXT_PUBLIC_DISCORD_CLIENT_ID="SEU_DISCORD_CLIENT_ID_AQUI"

# Permissões do Bot (8 = Administrador, ou 268487712 para permissões personalizadas)
DISCORD_BOT_PERMISSIONS="8"

# URL base da API da plataforma
NEXT_PUBLIC_API_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3000"
